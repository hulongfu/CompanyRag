# CompanyRag 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# DashScope API 配置（通义千问）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# SiliconFlow API 配置（Embedding/Rerank）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key

# 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=company_rag
POSTGRES_USER=company_rag_user
POSTGRES_PASSWORD=your-secure-postgres-password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# 服务配置
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT 配置（密钥必须是 Base64 编码，至少 32 字节）
# 生成命令：python -c "import base64; import secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 注意：请勿提交真实密钥到版本控制系统！
JWT_SECRET=<your-base64-encoded-jwt-secret-here>

# Grafana 配置（⚠️ 生产环境必须修改为强密码！）
# 建议使用至少 16 位随机密码，包含大小写字母、数字和特殊字符
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-admin-password

# 告警通知（Alertmanager SMTP）
# 163 邮箱需使用「授权码」而非登录密码（邮箱设置 → 客户端授权密码 中生成）
# 端口用 25（STARTTLS）：本网络环境 587/465 被 163 侧限制，仅 25 可用（SMTP 端口在 alertmanager.yml 配置）
# SMTP_FROM 与 SMTP_USERNAME 通常相同（如 you@163.com）
SMTP_FROM=
SMTP_USERNAME=
SMTP_AUTHORIZATION_CODE=
SMTP_TO=
