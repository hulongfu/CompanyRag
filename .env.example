# CompanyRag 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置值
# 
# 重要提示：所有标记为【必须配置】的变量在生产环境必须设置，不可使用默认值

# =============================================================================
# 安全相关 - 【必须配置】
# =============================================================================

# JWT Token 密钥 - 【必须配置】生产环境必须设置强随机密钥
# 生成方法：openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_must_be_strong_random_string

# =============================================================================
# AI 模型配置 - 【必须配置】
# =============================================================================

# DashScope API 配置（通义千问）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# SiliconFlow API 配置（可选，用于 Embedding 和 Rerank）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# =============================================================================
# 数据库配置 - 【必须配置】
# =============================================================================

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=company_rag
# 数据库用户名 - 生产环境不应使用默认值
POSTGRES_USER=company_rag_user
# 数据库密码 - 【必须配置】生产环境必须设置强密码
POSTGRES_PASSWORD=your_strong_database_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# Docker Compose 配置 - 【必须配置】
# =============================================================================

# Grafana 管理员密码 - 【必须配置】生产环境必须修改
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# =============================================================================
# 服务配置
# =============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
