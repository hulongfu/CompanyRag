# CompanyRag Docker 部署环境变量配置（示例模板）
# 用于 Docker 容器间通信
# 
# 使用说明：
# 1. 复制此文件为 .env.docker：copy .env.docker.example .env.docker
# 2. 根据实际情况修改以下敏感配置项
# 3. 切勿将包含真实密钥的 .env.docker 文件提交到 Git 仓库

# 【必须配置】DashScope API Key（通义千问 - Chat 模型）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 【必须配置】SiliconFlow API Key（硅基流动 - Embedding 和 Rerank 模型）
# 获取地址：https://platform.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# 【必须配置】数据库配置（容器间通信使用容器名称）
# POSTGRES_HOST：PostgreSQL 容器名称（Docker 网络中）
POSTGRES_HOST=docker-pgvector-1
POSTGRES_PORT=5432
POSTGRES_DB=company_rag
POSTGRES_USER=postgres
# 【必须修改】数据库密码（生产环境必须使用强密码）
POSTGRES_PASSWORD=your_strong_database_password_here

# 【必须配置】Redis 配置
# REDIS_HOST：Redis 容器名称（Docker 网络中）
REDIS_HOST=docker-redis-1
REDIS_PORT=6379
# 【必须修改】Redis 密码（生产环境必须使用强密码）
REDIS_PASSWORD=your_strong_redis_password_here

# 【可选】服务配置
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# 【必须配置】JWT 密钥（Base64 编码）
# 生成方法：openssl rand -base64 32 | tr -d '\n'
# 或者使用 PowerShell：[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# 
# 重要说明：
# - JWT_SECRET 不是登录密码，而是用于签名和验证 JWT Token 的密钥
# - 修改 JWT_SECRET 后，之前颁发的所有 Token 会失效，用户需要重新登录
# - 生产环境必须使用强随机密钥，切勿使用示例密钥
JWT_SECRET=your-base64-encoded-jwt-secret-key-here

# 【可选】代码搜索根目录（默认使用项目根目录）
# CODE_SEARCH_SRC_BASE=/path/to/your/source/code
